{
 "version": 1,
 "note": "Each case: feed `inputs` as successive lines (without newline) to ONE fresh parser; output for line i must equal spans[i]. Style persists across lines.",
 "cases": [
  {
   "name": "plain",
   "inputs": [
    "hello"
   ],
   "spans": [
    [
     {
      "s": "hello"
     }
    ]
   ]
  },
  {
   "name": "blank",
   "inputs": [
    ""
   ],
   "spans": [
    []
   ]
  },
  {
   "name": "red then reset",
   "inputs": [
    "\u001b[31mred\u001b[0m plain"
   ],
   "spans": [
    [
     {
      "s": "red",
      "fg": 1
     },
     {
      "s": " plain"
     }
    ]
   ]
  },
  {
   "name": "bright fg 91",
   "inputs": [
    "\u001b[91mX"
   ],
   "spans": [
    [
     {
      "s": "X",
      "fg": 9
     }
    ]
   ]
  },
  {
