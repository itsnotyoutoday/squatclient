<!-- name: Evennia cockpit -->
<!-- The showcase: everything a layout can do, against the local Evennia test game.
       markup   components and plain HTML, arranged with resizable docks (drag an edge; double-click resets)
       <script> JavaScript/TypeScript in the window: hooks, state, a live HP chart, derived values
       <lua>    Lua in the engine: tracks vitals, raises alerts, auto-heals, counts, keeps a clock
       <style>  CSS for the layout, here a pulsing warning banner
     JavaScript and Lua share variables both ways: Lua's squat.var.set("danger", ...) shows up here as
     useVar("danger"), and setVar("autoheal", true) here is squat.var.get("autoheal") in Lua. -->
<App>
  <When var="alert">
    <Dock side="top">
      <div className={`cp-banner cp-${danger}`} role="alert">
        {alert}
        {autoheal && <span className="cp-tag">auto-heal on</span>}
      </div>
    </Dock>
  </When>

  <Row>
    <Dock side="left" width={235} resizable id="cockpit-left">
      <When gmcp="Char.Status">
        <Panel title="Character">
          <Text label="Name" value="gmcp:Char.Status.name" />
          <Text label="Class" value="gmcp:Char.Status.class" />
          <Text label="Level" value="gmcp:Char.Status.level" />
          <Text label="Gold" value="gmcp:Char.Status.gold" />
          <Gauge label="XP" value="gmcp:Char.Status.xp" max="gmcp:Char.Status.nextxp" color="accent" format="{percent}" />
        </Panel>
      </When>

      <Panel title="Vitals">
        <Vitals />
        {hist.length > 1 && (
          <svg className="cp-spark" viewBox="0 0 100 30" preserveAspectRatio="none" aria-label="HP over time">
            <polyline points={points} />
          </svg>
        )}
      </Panel>

      <Panel title="Combat" collapsible>
        <Row gap={6}>
          <Button send="hurt 10" title="Take 10 damage (to test the alerts)">Hurt</Button>
          <Button send="heal" title="Costs mana">Heal</Button>
          <Button send="run">Run</Button>
        </Row>
        <label className="cp-switch">
          <input type="checkbox" checked={autoheal} onChange={(e) => setVar('autoheal', e.target.checked)} />
          Auto-heal below {healAt}%
        </label>
        <input
          className="cp-range"
          type="range" min="10" max="90" step="5"
          value={healAt}
          onChange={(e) => setVar('heal_at', Number(e.target.value))}
          aria-label="Auto-heal threshold"
        />
      </Panel>

      <Panel title="Session" collapsible>
        <Table value={stats} columns={[{ key: 'stat', title: 'Stat' }, { key: 'value', title: '' }]} />
        <Button send="/stats">Print to window</Button>
      </Panel>
    </Dock>

    <Mush />

    <Dock side="right" width={265} resizable id="cockpit-right">
      <Panel title="Room"><RoomInfo /></Panel>
      <List title="Inventory" value="items:inv" send="look {name}" empty="Nothing carried." />
      <Chat height={170} />
    </Dock>
  </Row>

  <Dock side="bottom">
    <Row gap={6}>
      <Button send="look">Look</Button>
      {exits.map((x) => (
        <Button key={x} send={x}>{x}</Button>
      ))}
      <Spacer />
      <span className="cp-clock" title="Time since this layout loaded (a Lua timer)">⏱ {clock}</span>
    </Row>
  </Dock>
  <InputBar />
</App>

<script>
  // ---- reads: GMCP from the game, variables from Lua (the same store the buttons write to)
  const danger = (useVar('danger') as string) ?? 'ok';
  const alert = (useVar('alert') as string) ?? '';
  const autoheal = Boolean(useVar('autoheal'));
  const healAt = Number(useVar('heal_at') ?? 40);
  const setVar = useSetVar();

  const hp = Number(useGmcp('Char.Vitals.hp'));
  const maxhp = Number(useGmcp('Char.Vitals.maxhp')) || 100;
  const exitsRaw = useGmcp('Room.Info.exits');
  const exits = exitsRaw && typeof exitsRaw === 'object' ? Object.keys(exitsRaw as object) : [];

  // ---- state: the last 40 HP readings, drawn as a chart
  const [hist, setHist] = React.useState<number[]>([]);
  React.useEffect(() => {
    if (Number.isFinite(hp)) setHist((h) => [...h, hp / maxhp].slice(-40));
  }, [hp, maxhp]);
  const points = hist.map((v, i) => `${(i / 39) * 100},${29 - Math.max(0, Math.min(1, v)) * 28}`).join(' ');

  // ---- numbers Lua keeps
  const secs = Number(useVar('uptime') ?? 0);
  const clock = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
  const stats = [
    { stat: 'Damage taken', value: String(useVar('damage_taken') ?? 0) },
    { stat: 'Healed', value: String(useVar('heals') ?? 0) },
    { stat: 'Rooms seen', value: String(useVar('rooms') ?? 0) },
    { stat: 'Level-ups', value: String(useVar('levelups') ?? 0) },
  ];
</script>

<lua>
-- Runs in the engine for as long as this layout is shown. Handlers, timers and rules vanish when you
-- switch layouts; the variables stay.
local hp, maxhp = nil, 100
local last_heal = 0
local rooms = {}

local function count(t) local n = 0 for _ in pairs(t) do n = n + 1 end return n end

-- defaults (only if nothing set them already)
local function default(name, v)
  if squat.var.get(name) == nil then squat.var.set(name, v) end
end
default("autoheal", false)
default("heal_at", 40)
squat.var.set("uptime", 0)
squat.var.set("damage_taken", squat.var.get("damage_taken", 0))
squat.var.set("heals", squat.var.get("heals", 0))
squat.var.set("levelups", squat.var.get("levelups", 0))

-- the danger level and the banner text, from HP
local function assess()
  if not hp then return end
  local pct = hp / maxhp * 100
  local level, text = "ok", ""
  if pct <= 15 then level, text = "critical", "CRITICAL: " .. hp .. "/" .. maxhp .. " HP"
  elseif pct <= squat.var.get("heal_at", 40) then level, text = "low", "Low health: " .. hp .. "/" .. maxhp .. " HP"
  end
  if level ~= squat.var.get("danger") then
    squat.var.set("danger", level)
    if level == "critical" then squat.notify("Critical health", hp .. "/" .. maxhp .. " HP") end
  end
  squat.var.set("alert", text)
  -- auto-heal, at most every 3 seconds
  if level ~= "ok" and squat.var.get("autoheal") and squat.now() - last_heal > 3 then
    last_heal = squat.now()
    squat.send("heal")
  end
end

squat.on("gmcp", function(e)
  local name = e.package:lower()
  if name == "char.vitals" then
    local d = e.data or {}
    hp = tonumber(d.hp) or hp
    maxhp = tonumber(d.maxhp) or maxhp
    assess()
  elseif name == "room.info" and e.data and e.data.name then
    if not rooms[e.data.name] then
      rooms[e.data.name] = true
      squat.var.set("rooms", count(rooms))
    end
  end
end)

-- lines of text from the game
squat.trigger{match = "^You take (\\d+) damage", regex = true, fn = function(m)
  squat.var.set("damage_taken", squat.var.get("damage_taken", 0) + tonumber(m[1]))
end}
squat.trigger{match = "*mends your wounds*", fn = function()
  squat.var.set("heals", squat.var.get("heals", 0) + 1)
end}
squat.trigger{match = "*You feel stronger*", fn = function()
  squat.var.set("levelups", squat.var.get("levelups", 0) + 1)
  squat.notify("Level up!", "You feel stronger")
end}

-- a command typed in the window, answered without going to the game
squat.alias{match = "/stats", fn = function()
  squat.echo(string.format("[cockpit] damage taken %d, healed %d times, %d rooms, %d level-ups",
    squat.var.get("damage_taken", 0), squat.var.get("heals", 0),
    squat.var.get("rooms", 0), squat.var.get("levelups", 0)))
end}

-- a clock, once a second
squat.timer{every = 1, fn = function()
  squat.var.set("uptime", squat.var.get("uptime", 0) + 1)
end}
</lua>

<style>
  .cp-banner {
    padding: 4px 10px;
    font-weight: 600;
    text-align: center;
    color: var(--ui-accent-text);
  }
  .cp-banner.cp-low { background: var(--ui-warn); color: #000; }
  .cp-banner.cp-critical { background: var(--ui-danger); animation: cp-pulse 0.9s ease-in-out infinite; }
  @keyframes cp-pulse { 50% { opacity: 0.55; } }
  .cp-tag {
    margin-left: 10px;
    padding: 0 6px;
    border-radius: 8px;
    font-size: 11px;
    background: rgba(0, 0, 0, 0.3);
  }
  .cp-spark { width: 100%; height: 34px; margin-top: 4px; }
  .cp-spark polyline { fill: none; stroke: var(--ui-accent); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .cp-switch { display: flex; gap: 6px; align-items: center; font-size: 12px; margin-top: 6px; }
  .cp-range { width: 100%; }
  .cp-clock { font-variant-numeric: tabular-nums; color: var(--ui-text-dim); }
  @media (prefers-reduced-motion: reduce) { .cp-banner.cp-critical { animation: none; } }
</style>
