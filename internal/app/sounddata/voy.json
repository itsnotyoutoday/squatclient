{
  "format": 1,
  "id": "voy",
  "title": "Long-voyage style",
  "folder": "voy",
  "notes": "Contains no audio. Put your own recordings in <local sound folder>/voy/ using these names; any file you leave out falls back to the pack's sound, then to a synthesised one. ",
  "events": {
    "red_alert": [
      {
        "stages": [
          {
            "at_s": 0,
            "file": "voy/red_alert.wav",
            "loop": true
          },
          {
            "at_s": 60,
            "file": "voy/red_alert_long.wav",
            "loop": true,
            "crossfade_ms": 1000
          }
        ],
        "on_stop": {
          "file": "voy/alert_off.wav"
        }
      }
    ],
    "yellow_alert": [
      {
        "file": "voy/yellow_alert.wav",
        "loop": true
      }
    ],
